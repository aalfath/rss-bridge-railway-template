server {
    listen __PORT__ default_server;
    listen [::]:__PORT__ default_server;
    root /app;
    index index.php;
    server_tokens off;
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location ~ /(\.|vendor|tests) {
        deny all;
        return 403;
    }

    # Health check for Railway: runs RSS-Bridge's own health action through PHP-FPM,
    # with the access token added here so the probe needs no secret.
    location = /healthz {
        access_log off;
        rewrite ^ /index.php?action=health__TOKEN_ARG__ last;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_read_timeout 45s;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
    }
}
